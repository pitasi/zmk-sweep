#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// OS layout assumed: macOS ABC/US.
// Accents come from Option dead keys: RA(GRAVE)+vowel = grave, RA(E)+vowel = acute.
//
// Home-row mods (Miryoku GACS order), tuned with positional hold-tap:
//   Left  home row:  A=Gui  S=Alt  D=Ctrl  F=Shift
//   Right home row:  J=Shift  K=Ctrl  L=Alt  '=Gui
// A left-hand mod only activates as a mod when the *next* key is on the right
// hand or a thumb (and vice-versa), so same-hand rolls stay plain letters.
// require-prior-idle-ms makes them behave as plain letters during fast typing;
// Shift (F/J) is exempt from it, since capitals follow a keypress by nature.
//
// Ctrl/Cmd shortcuts therefore need no dedicated keys: hold the opposite-hand
// mod and press the real letter, on the base layer.
//   C-c=K+C  C-d=K+D  C-f=K+F  C-u=D+U  C-n=D+N  C-p=D+P
//   Cmd-c=' +C  Cmd-v=' +V  Cmd-z=' +Z  etc.

// Layer definitions
    #define BASE 0
    #define SYM 1
    #define EXT 2
    #define FNC 3
    #define SYM2 4
    #define ACCENT 5
    #define SETTINGS 6
// -----------------

// Positional hold-tap key groups (used by home-row mods below).
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24   // left hand
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29   // right hand
#define THUMBS 30 31 32 33

&mt {
   //  flavor = "tap-preferred";
   // tapping_term_ms = <200>;
};

&sk {
    ignore-modifiers;
};

/ {
    behaviors {
        // Home-row mod, left hand: only holds when a right-hand/thumb key follows.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        // Home-row mod, right hand: only holds when a left-hand/thumb key follows.
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        // Shift-only variants of the above, without require-prior-idle-ms:
        // capitals almost always follow a keypress (space or the previous
        // letter), so that guard kills the hold exactly when Shift is wanted.
        // The other mods keep it because a stray Gui/Ctrl fires app shortcuts,
        // while a stray capital is only a typo.
        hsl: home_row_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hsr: home_row_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        // Thumb layer-taps. Stock &lt is tap-preferred, so the layer only
        // engages once the 200ms term expires — a fast chord releases the thumb
        // before that and emits ESC/ENTER instead. Balanced resolves to the
        // layer as soon as the chorded key is released.
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
            // sometimes my device thinks a modifier is being held down
            // pressing all modifiers fixes it.
            unstick: unstick {
                label = "ZM_unstick";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
            };
            // grave accent: AltGr+` dead key, then the letter (à è ì ò ù)
            agr: agr {
                label = "ZM_agr";
                compatible = "zmk,behavior-macro-one-param";
                #binding-cells = <1>;
                bindings = <&kp RA(GRAVE)>, <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>;
            };
            // acute accent: Opt+e dead key, then the letter (é)
            aac: aac {
                label = "ZM_aac";
                compatible = "zmk,behavior-macro-one-param";
                #binding-cells = <1>;
                bindings = <&kp RA(E)>, <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>;
            };
    };

    combos {
        compatible = "zmk,combos";
            // both right thumb keys
        combo_accent {
            timeout-ms = <300>;
            key-positions = <32 33>;
            bindings = <&mo ACCENT>;
            slow-release;
        };
            // internal-left & external-right thumb keys
            combo_sym2 {
                    timeout-ms = <200>;
                    key-positions = <31 33>;
                    bindings = <&mo SYM2>;
                    slow-release;
            };
            // both left thumbs + right-inner thumb (deliberate, rare layer).
            // Not <30 31> anymore: that shadowed EXT-hold + inner-thumb TAB.
            combo_settings {
                    timeout-ms = <300>;
                    key-positions = <30 31 32>;
                    bindings = <&mo SETTINGS>;
                    slow-release;
            };
    };

    keymap {
            compatible = "zmk,keymap";

        // Base alpha layer + home-row mods.
        default_layer {
        bindings = <
        &kp Q        &kp W        &kp E         &kp R         &kp T        &kp Y  &kp U         &kp I         &kp O        &kp P
        &hml LGUI A  &hml LALT S  &hml LCTRL D  &hsl LSHFT F  &kp G        &kp H  &hsr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SQT
        &kp Z        &kp X        &kp C         &kp V         &kp B        &kp N  &kp M         &kp COMMA     &kp DOT      &kp SEMI
                                       &tlt EXT ESC  &kp SPACE      &kp BSPC  &tlt SYM ENTER
        >;
        };

        // Numbers and high frequency symbols
        sym_layer {
        bindings = <
        &kp N1 &kp N2   &kp N3   &kp N4   &kp N5      &kp N6    &kp N7    &kp N8  &kp N9    &kp N0
        &kp LT &kp DLLR &kp LPAR &kp LBRC &kp LBKT    &kp EQUAL &kp QMARK &kp SQT &kp MINUS &kp ASTRK
        &kp GT &kp PRCNT &kp RPAR &kp RBRC &kp RBKT   &kp AT    &kp EXCL  &kp DQT &kp PLUS  &kp FSLH
                                &mo FNC  &mo SYM2      &trans &trans
        >;
        };

        // Navigation, page movement, and mods for chording with arrows.
        // Reached by holding the left-outer thumb (also taps ESC).
        ext_layer {
        bindings = <
        &kp ESC   &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4)    &kp HOME     &kp PG_DN &kp PG_UP &kp END   &kp LG(N5)
        &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHFT  &kp RALT      &kp LEFT     &kp DOWN  &kp UP    &kp RIGHT &kp DEL
        &none     &none      &none      &none      &none         &kp LC(BSPC) &kp BSPC  &kp CAPS  &none     &none
                                    &trans  &kp TAB       &kp LS(TAB)  &mo FNC
        >;
        };

        // Function keys with modifiers
        fnc_layer {
        bindings = <
        &kp F1   &kp F2   &kp F3    &kp F4    &kp F5      &kp F6  &kp F7  &kp F8          &kp F9 &kp F10
        &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &kp RALT    &kp F11 &kp F12 &kp PRINTSCREEN &none  &none
        &none    &none    &none     &none     &none       &none   &none   &none           &none  &none
                                &none &none        &none &none
        >;
        };

        // Low frequency symbols.
        symbols_2_layer {
        bindings = <
        &kp CARET &kp UNDER &kp RA(N3) &kp RA(LS(N2)) &kp HASH    &none &none &none &none &none
        &kp GRAVE &kp TILDE &kp BSLH  &kp PIPE        &kp AMPS    &none &none &none &none &none
        &none     &none     &kp RA(N6) &kp RA(C)      &kp RA(LS(N8))  &none &none &none &none &none
                                    &none &none        &none &none
        >;
        };

        // Used to type regional accents.
        accent_layer {
        bindings = <
        &kp RA(GRAVE) &kp RA(E) &none  &kp RA(C) &none    &none &none &none &none &none
        &agr A        &agr I    &agr O &agr E    &aac E   &none &none &none &none &none
        &none         &none     &none  &agr U    &none    &none &none &none &none &none
                                    &none &none        &none &none
        >;
        };

        // Used to change the keyboard's settings.
        settings_layer {
        bindings = <
        &bootloader &none &none &bt BT_CLR &bt BT_SEL 0    &bt BT_SEL 3 &none &unstick &none &bootloader
        &none &none &none &none      &bt BT_SEL 1           &bt BT_SEL 4 &none &none    &none &none
        &none &none &none &none      &bt BT_SEL 2           &bt BT_SEL 5 &none &none    &none &none
                                &none &none        &none &none
        >;
        };

    };
};
